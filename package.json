{
  "name": "python-trainer",
  "private": true,
  "version": "2.0.0",
  "description": "Інтерактивний тренажер Python для дата-аналітика: справжній Python у браузері (Pyodide), уроки, вправи і багатокрокові задачі за рівнями складності",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "node scripts/verify-content.mjs",
    "check": "npm test && npm run verify && npm run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/commissioner": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "pyodide": "314.0.7",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
